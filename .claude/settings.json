{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.keystore)",
      "Read(./**/id_rsa*)",
      "Read(./**/credentials.json)",
      "Read(./**/*credentials*)",
      "Read(./**/*Credentials*)",
      "Read(./**/*CREDENTIALS*)",
      "Read(//**/.aws/credentials)",
      "Read(//**/.kube/config)",
      "Read(//**/.ssh/**)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
