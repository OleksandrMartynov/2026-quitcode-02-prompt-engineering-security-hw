{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.keystore)",
      "Read(./**/id_rsa*)",
      "Read(./**/credentials.json)",
      "Read(./**/*credentials*)",
      "Read(./**/*Credentials*)",
      "Read(./**/*CREDENTIALS*)",
      "Read(//**/.aws/credentials)",
      "Read(//**/.kube/config)",
      "Read(//**/.ssh/**)",
      "Read(./**/*KEY*)",
      "Read(./**/*TOKEN*)",
      "Read(./**/*SECRET*)",
      "Read(./**/*api-key*)",
      "Read(./**/*api_key*)",
      "Read(./**/*apikey*)",
      "Read(./**/secrets.*)",
      "Read(./**/*_key*)",
      "Read(./**/*-key*)",
      "Read(./**/*.key.*)",
      "Read(./**/*_token*)",
      "Read(./**/*-token*)",
      "Read(./**/*_secret*)",
      "Read(./**/*-secret*)",
      "Read(./**/*.secret*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
