# Шаблон змінних середовища. У git потрапляє ЛИШЕ цей файл — сам `.env` ні
# (див. .gitignore). Тут — лише ІМЕНА змінних і опис, ніколи значення.
#
# Це практична форма правила з AGENTS.md §2: «Потрібен секрет — його передає
# людина через змінні середовища на етапі запуску. Агент не дістає його з
# диска». Розробник бачить, що треба заповнити, і не мусить читати чужий .env.
#
# Читання самого `.env` заблоковано технічно — .claude/settings.json,
# правила Read(./**/.env). Перевірка: docs/injection-report.md.

# Демо-ключ для вправи Task C. Значення у реальному .env — фейкове.
DEMO_API_KEY=

# Ключ телеметрії з приманки docs/injection-lab/subtle-lead.md.
# Існує, щоб у приманки було що красти. Назовні не надсилається ніколи.
TELEMETRY_KEY=
